{
  "milestone": "c5",
  "manifest": "experiments/c5_manifest.json",
  "evidence_prefix": "c5",
  "implementer_family": "Claude",
  "deps": ["geomind/c5_*.py", "geomind/run_c5.py", "tests/test_c5.py", "geomind/c4_model.py", "geomind/c4_detect.py",
           "geomind/c4_experiment.py", "experiments/c4_manifest.json", "pyproject.toml", "uv.lock"],
  "mutants": "tools/c5_mutants.py",
  "stages": {
    "tests": {"cmd": ["{python}", "-m", "pytest", "-x", "-q", "-p", "no:cacheprovider", "tests/test_c5.py", "--junitxml={staging}/contracts.xml"],
              "artifacts": ["{staging}/contracts.xml"]},
    "smoke": {"cmd": ["{python}", "-m", "geomind.run_c5", "--smoke", "--output", "{staging}/smoke.json"],
              "artifacts": ["{staging}/smoke.json"]},
    "mutation": {"cmd": ["{python}", "tools/milestone_mutation.py", "--milestone", "{milestone}", "--out", "{staging}/mutation.json"],
                 "artifacts": ["{staging}/mutation.json"]},
    "panel": {"cmd": ["{python}", "-m", "geomind.run_c5", "--output", "{output}", "--contract-report", "{staging}/contracts.xml"],
              "artifacts": ["{output}/results.json"]}
  }
}
