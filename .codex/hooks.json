{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/gate_hook.py\"",
            "statusMessage": "Checking the verification gate",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
