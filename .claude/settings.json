{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/gate_hook.py\"",
            "timeout": 30,
            "statusMessage": "Checking the verification gate"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/milestone_hook.py\"",
            "timeout": 30,
            "statusMessage": "Checking the milestone gate"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/gate_hook.py\"",
            "timeout": 30,
            "statusMessage": "Checking the review gate"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/milestone_hook.py\"",
            "timeout": 30,
            "statusMessage": "Checking the milestone gate"
          }
        ]
      }
    ]
  }
}
